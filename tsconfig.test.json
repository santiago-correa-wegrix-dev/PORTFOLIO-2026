{
  "include": ["test/**/*", ".react-router/types/**/*"],
  "compilerOptions": {
    "composite": false,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ES2022",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": { "~/*": ["./app/*"] },
    "rootDirs": [".", "./.react-router/types"],
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["vitest/globals", "vite/client", "node"]
  }
}
