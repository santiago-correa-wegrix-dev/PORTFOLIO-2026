{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "analyze": "ANALYZE=true react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "wireit",
    "lint": "oxlint --fix .",
    "lint:check": "wireit",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "test": "vitest",
    "test:run": "wireit",
    "check": "wireit",
    "prepare": "[ -d .git ] && husky || true"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/geist-mono": "^5.2.7",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-router/node": "7.15.0",
    "@react-router/serve": "^7.15.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@react-three/postprocessing": "^3.0.4",
    "@types/d3": "^7.4.3",
    "@types/three": "^0.170.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "framer-motion": "^12.27.0",
    "intlayer": "^8.9.3",
    "isbot": "^5.1.32",
    "lenis": "^1.3.17",
    "lucide-react": "^0.562.0",
    "pino": "^10.3.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-intlayer": "^8.9.3",
    "react-router": "7.15.0",
    "resend": "^6.7.0",
    "simple-icons": "^16.6.0",
    "swiper": "^12.1.4",
    "tailwind-merge": "^3.4.0",
    "three": "^0.170.0",
    "zod": "^4.3.5",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@react-router/dev": "7.15.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.19.7",
    "@types/react": "^19.2.8",
    "@types/react-dom": "^19.2.3",
    "husky": "^9.1.7",
    "oxfmt": "^0.48.0",
    "oxlint": "^1.63.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^8.0.11",
    "vite-intlayer": "^8.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.0.17",
    "wireit": "^0.14.12"
  },
  "pnpm": {
    "overrides": {
      "vite": "$vite"
    }
  },
  "wireit": {
    "lint:check": {
      "command": "oxlint .",
      "files": [
        "app/**/*.{ts,tsx}",
        "test/**/*.ts",
        ".oxlintrc.json"
      ]
    },
    "test:run": {
      "command": "vitest run",
      "files": [
        "app/**/*.{ts,tsx}",
        "test/**/*.ts",
        "vitest.config.ts"
      ]
    },
    "typecheck": {
      "command": "react-router typegen && tsc -b",
      "files": [
        "app/**/*.{ts,tsx}",
        "tsconfig.json"
      ],
      "output": [
        ".react-router/types/**"
      ]
    },
    "check": {
      "dependencies": [
        "lint:check",
        "test:run",
        "typecheck"
      ]
    }
  }
}
