{
  "$schema": "https://raw.githubusercontent.com/nicolo-ribaudo/oxc-config-schema/refs/heads/main/.oxlintrc.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "pedantic": "warn",
    "perf": "warn",
    "style": "warn",
    "nursery": "off"
  },
  "rules": {
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }],
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "no-explicit-any": "error",
    "eqeqeq": "error",
    "sort-imports": ["error", { "allowSeparatedGroups": true, "ignoreDeclarationSort": true }],
    "no-var": "error",
    "prefer-const": "error",
    "id-length": ["warn", { "min": 2, "exceptions": ["x", "y", "z"] }],
    "max-params": ["warn", { "max": 2 }],
    "numeric-separators-style": "off",
    "func-style": "off",
    "no-ternary": "off",
    "no-nested-ternary": "error",
    "no-magic-numbers": "off",
    "no-inline-comments": "off",
    "max-lines-per-function": ["warn", { "max": 250 }],
    "max-statements": "off",
    "init-declarations": "off",
    "no-negated-condition": "off",
    "no-shadow": "error",
    "require-await": "error",
    "unicorn/no-null": "off",
    "unicorn/consistent-function-scoping": "error",
    "unicorn/prefer-ternary": "off",
    "unicorn/no-negated-condition": "off"
  },
  "ignorePatterns": ["dist", "build", ".react-router", "node_modules"]
}
